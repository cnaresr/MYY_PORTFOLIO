---
import { portfolioConfig } from '../config';

const testimonials = portfolioConfig.testimonials;
---

{testimonials.length > 0 && (
  <section
    id="testimonials"
    class="w-full py-16 md:py-20 bg-[#f8f9ff] dark:bg-[#050811] border-t border-slate-200/80 dark:border-slate-800 relative transition-colors"
    aria-labelledby="testimonials-heading"
  >
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="mb-10">
        <span class="font-mono text-[11px] uppercase tracking-widest font-bold text-[#00bc7d] block mb-2">
          CLIENT FEEDBACK
        </span>
        <h2
          id="testimonials-heading"
          class="font-['Space_Grotesk'] text-3xl sm:text-4xl font-bold text-slate-950 dark:text-white tracking-tight text-balance"
        >
          What clients say
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((item) => (
          <blockquote class="flex flex-col justify-between p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs">
            <p class="font-['Hanken_Grotesk'] text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed mb-6 text-pretty">
              &ldquo;{item.quote}&rdquo;
            </p>
            <footer class="border-t border-slate-100 dark:border-slate-800 pt-4">
              <div class="font-['Space_Grotesk'] text-sm font-bold text-slate-950 dark:text-white">
                {item.author}
              </div>
              <div class="font-mono text-xs text-slate-500 dark:text-slate-400">
                {item.role}{item.company ? ` · ${item.company}` : ''}
              </div>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}
