---
// CredentialCard.astro — kartu sertifikat FINAL (arah logo issuer, compact & selaras)
// Compact: logo/pengganti inisial + judul + issuer/tahun + tombol VERIFY
// kondisional (hanya muncul jika verifyUrl diisi).
// Dipakai bersama oleh varian section B dan C — datanya dari src/data/certificates.ts.

interface Props {
  title: string;
  issuer: string;
  year: string;
  verifyUrl?: string;
  logo?: string;
  initials?: string;
  index?: string;
}

const {
  title,
  issuer,
  year,
  verifyUrl = "",
  logo = "",
  initials = "",
  index = "",
} = Astro.props;

const badge = initials || issuer.replace(/[^A-Za-z]/g, "").slice(0, 2).toUpperCase();
const logoAlt = `Logo ${issuer}`;
---

<article class="cc-card group relative w-[270px] sm:w-[300px] h-[220px] shrink-0 flex flex-col justify-between rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-xl dark:shadow-slate-950/60 hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-all duration-300 p-4 sm:p-4.5 overflow-hidden">
  <!-- Watermark Serial Index Number inside Card (Subtle Blueprint Background) -->
  {index && (
    <div
      class="pointer-events-none absolute -top-3 -right-1 select-none font-mono text-5xl font-black text-slate-950/[0.03] dark:text-white/[0.03] tracking-tighter"
      aria-hidden="true"
    >
      {index}
    </div>
  )}

  <!-- Top Row: Logo Badge + Metadata (Index Pill & Year Pill) -->
  <div class="relative z-10 flex items-center justify-between gap-2 pb-2 border-b border-slate-100 dark:border-slate-800/80">
    <div class="flex items-center gap-2.5">
      <div class="cc-logo" title={issuer}>
        {logo ? (
          <img src={logo} alt={logoAlt} width="36" height="36" loading="lazy" decoding="async" />
        ) : (
          <span aria-hidden="true">{badge}</span>
        )}
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 uppercase tracking-widest font-semibold">
          ISSUER
        </span>
        <span class="font-mono text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate max-w-[150px] sm:max-w-[170px]" title={issuer}>
          {issuer}
        </span>
      </div>
    </div>

    <!-- Telemetry Year Tag & Status -->
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="font-mono text-[10px] text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 rounded-md px-1.5 py-0.5 font-semibold tabular-nums">
        {year}
      </span>
      <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500" title="Active Credential" aria-hidden="true"></span>
    </div>
  </div>

  <!-- Middle: Title (Fixed 2-Line Baseline for Perfect Cross-Card Alignment) -->
  <div class="relative z-10 my-auto py-1">
    <h3 class="cc-title font-['Space_Grotesk'] text-sm sm:text-[15px] font-bold text-slate-950 dark:text-white tracking-tight leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 min-h-[2.5rem] flex items-start">
      {title}
    </h3>
  </div>

  <!-- Bottom Row: Unified Structured Footer with Aligned Baseline -->
  <div class="relative z-10 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
    {verifyUrl ? (
      <a
        class="cc-verify inline-flex items-center gap-1 font-['Space_Grotesk'] text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-1 rounded-sm cursor-pointer select-none"
        href={verifyUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Verify ${title} credential from ${issuer} (opens in new tab)`}
      >
        <span>VERIFY</span>
        <span aria-hidden="true" class="text-[13px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1 font-mono text-[11px] text-slate-400 dark:text-slate-500 italic select-none">
        <span class="material-symbols-outlined text-[13px] not-italic">lock</span>
        <span>doc on request</span>
      </span>
    )}

    <!-- Verification Seal Stamp -->
    <div
      class="w-6 h-6 shrink-0 rounded-full border border-emerald-500/25 bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-[11px] font-bold shadow-2xs select-none"
      title="Verified Credential Ledger"
      aria-hidden="true"
    >
      ✓
    </div>
  </div>
</article>

<style>
  .cc-logo {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.55rem;
    border: 1px solid #e3e8f2;
    background: #020618;
    display: grid;
    place-items: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .cc-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.25rem;
  }
  .cc-logo span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #fff;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  :global(.dark) .cc-logo {
    background: #0f172a;
    border-color: #334155;
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-card,
    .cc-card:hover {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
