---
import { siteConfig } from '../data/siteConfig';
import { ContactForm } from './interactive/ContactForm';
import { GsapReveal } from './interactive/GsapReveal';
---

<section class="w-full py-16 md:py-24 bg-slate-100 dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800 relative transition-colors overflow-hidden" id="contact">
  <!-- Architectural Subtle Grid Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-40 dark:opacity-20 pointer-events-none z-0"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10 section-content-flow">
    
    <!-- Redesigned Architectural Header for Section 03: Contact -->
    <GsapReveal y={20} duration={0.7} selector=".reveal-contact-header">
      <div class="relative mb-12">
        <!-- Giant Architectural Watermark Serial Number -->
        <div class="pointer-events-none absolute -top-8 right-2 sm:right-6 select-none font-mono text-7xl sm:text-8xl lg:text-9xl font-black text-slate-950/[0.03] dark:text-white/[0.03] tracking-tighter">
          03
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 relative z-10">
          <!-- Left Wing: Status Chip + Monumental Typography -->
          <div class="space-y-3">
            <div class="reveal-contact-header inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="font-mono text-[10px] uppercase tracking-widest font-bold text-slate-700 dark:text-slate-300">
                DIRECT DISPATCH // SECURE TRANSMISSION
              </span>
            </div>

            <div class="reveal-contact-header flex items-baseline gap-3 sm:gap-4 flex-wrap">
              <h2 class="font-['Space_Grotesk'] text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-none">
                Contact
              </h2>
              <span class="font-mono text-xs sm:text-sm text-slate-400 dark:text-slate-500 font-semibold tracking-wider uppercase">
                // CHANNELS &amp; INQUIRY
              </span>
            </div>
          </div>

          <!-- Right Wing: Precision Telemetry HUD Cards -->
          <div class="reveal-contact-header flex items-center gap-3 shrink-0">
            <!-- SLA Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 dark:text-emerald-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">bolt</span>
              </div>
              <div class="flex flex-col">
                <span class="font-['Space_Grotesk'] text-lg font-bold text-slate-950 dark:text-white leading-tight">
                  &lt; 24h
                </span>
                <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Response SLA
                </span>
              </div>
            </div>

            <!-- Gateway Status Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-500 dark:text-sky-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">mark_email_read</span>
              </div>
              <div class="flex flex-col">
                <span class="font-mono text-xs font-bold text-slate-950 dark:text-white leading-tight flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  READY
                </span>
                <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Inbound Console
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Architectural Blueprint Ruler Divider with Registration Marks -->
        <div class="relative w-full mt-2">
          <div class="w-full h-[1px] bg-slate-200/90 dark:bg-slate-800"></div>
          <span class="absolute -top-1.5 left-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <span class="absolute -top-1.5 right-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 px-3 bg-slate-100 dark:bg-slate-900 text-[9px] font-mono text-slate-400 dark:text-slate-500 uppercase tracking-widest whitespace-nowrap">
            SEC // 03 · DISPATCH &amp; COLLABORATION CONSOLE
          </div>
        </div>
      </div>
    </GsapReveal>

    <div class="contact-grid grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Column: Direct Connect Details -->
      <div class="contact-wing-left lg:col-span-5 flex flex-col justify-between">
        <div>
          <span class="font-['Space_Grotesk'] text-[11px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold block mb-1">
            DIRECT INQUIRY // COLLABORATION
          </span>
          <h3 class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white mb-3 tracking-tight leading-tight">
            Want to collaborate?
          </h3>
          <p class="font-['Hanken_Grotesk'] text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
            I'm a diploma student and self-taught full-stack developer — most at home on the backend and with SQL. I take on small freelance builds, internships, and open-source work, and I'm always glad to talk about any of it.
            <span class="block mt-2 font-semibold text-slate-800 dark:text-slate-200">Contact me at:</span>
          </p>

          <!-- Direct Email Badge with Copy Action -->
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 mb-4 shadow-xs">
            <div class="flex items-center gap-2 font-['Space_Grotesk'] text-[11px] text-slate-600 dark:text-slate-400 uppercase tracking-wider font-bold mb-2">
              <svg class="w-4 h-4 text-slate-700 dark:text-slate-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Email me</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm sm:text-[15px] text-slate-950 dark:text-white select-all font-semibold" id="emailText">
                {siteConfig.email}
              </span>
              <button
                type="button"
                id="copyEmailBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-mono font-semibold transition-colors cursor-pointer"
                title="Copy email to clipboard"
                aria-label="Copy email to clipboard"
              >
                <span class="material-symbols-outlined text-[16px]" id="copyBtnIcon" aria-hidden="true">content_copy</span>
                <span id="copyBtnLabel" role="status" aria-live="polite">Copy</span>
              </button>
            </div>
          </div>

          <!-- Office Address (only when filled in admin) -->
          {siteConfig.officeAddress && (
            <div class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 mb-4 shadow-xs">
              <span class="material-symbols-outlined text-slate-700 dark:text-slate-300 text-[22px]">business</span>
              <div>
                <span class="font-['Space_Grotesk'] text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold block">
                  OFFICE
                </span>
                <span class="font-['Hanken_Grotesk'] text-xs sm:text-sm text-slate-800 dark:text-slate-200 font-medium whitespace-pre-line">
                  {siteConfig.officeAddress}
                </span>
              </div>
            </div>
          )}

          <!-- Home / Residence Address (only when filled in admin) -->
          {siteConfig.homeAddress && (
            <div class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 mb-4 shadow-xs">
              <span class="material-symbols-outlined text-slate-700 dark:text-slate-300 text-[22px]">home</span>
              <div>
                <span class="font-['Space_Grotesk'] text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold block">
                  HOME
                </span>
                <span class="font-['Hanken_Grotesk'] text-xs sm:text-sm text-slate-800 dark:text-slate-200 font-medium whitespace-pre-line">
                  {siteConfig.homeAddress}
                </span>
              </div>
            </div>
          )}

          <!-- Quick Connect Links -->
          <div class="space-y-2">
            <span class="font-['Space_Grotesk'] text-[11px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold block">
              DIRECT FAST-CONNECTS
            </span>
            <div class="flex flex-wrap gap-2">
              {siteConfig.socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-black dark:hover:text-white font-mono text-xs font-semibold shadow-2xs transition-colors"
                >
                  <span>{social.name}</span>
                  <span class="material-symbols-outlined text-[14px]">{social.icon}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Inquiry Console -->
      <div class="contact-wing-right lg:col-span-7">
        <ContactForm
          client:load
          title="SECURE TRANSMISSION CONSOLE"
          subtitle="Tell me what you're building and where you'd like my help."
          successTitle="Message Received"
          siteName={siteConfig.name.split(' ')[0]}
          fallbackEmail={siteConfig.email}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from '../lib/gsap';

  // Dual-Wing Lateral Entry & Exit Animation (symmetrical reverse on exit)
  function initContactWings() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const leftWing = document.querySelector('.contact-wing-left');
    const rightWing = document.querySelector('.contact-wing-right');
    const container = document.querySelector('.contact-grid');

    if (leftWing && rightWing && container) {
      gsap.fromTo(
        leftWing,
        { x: -36, opacity: 0 },
        {
          x: 0,
          opacity: 1,
          duration: 0.75,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: container,
            start: 'top 85%',
            end: 'bottom bottom',
            toggleActions: 'play none none reverse',
          },
        }
      );

      gsap.fromTo(
        rightWing,
        { x: 36, opacity: 0 },
        {
          x: 0,
          opacity: 1,
          duration: 0.75,
          delay: 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: container,
            start: 'top 85%',
            end: 'bottom bottom',
            toggleActions: 'play none none reverse',
          },
        }
      );
    }
  }

  initContactWings();

  // Copy email micro-interaction
  const copyBtn = document.getElementById('copyEmailBtn');
  const copyLabel = document.getElementById('copyBtnLabel');
  const copyIcon = document.getElementById('copyBtnIcon');
  const emailText = document.getElementById('emailText');
  let copyResetTimer: ReturnType<typeof setTimeout> | undefined;

  const showCopiedState = () => {
    if (!copyBtn || !copyLabel || !copyIcon) return;
    clearTimeout(copyResetTimer);
    copyBtn.dataset.copied = 'true';
    copyBtn.title = 'Email copied to clipboard';
    copyBtn.setAttribute('aria-label', 'Email copied to clipboard');
    copyIcon.innerText = 'check';
    copyLabel.innerText = 'Copied!';
    copyResetTimer = setTimeout(() => {
      copyBtn.dataset.copied = 'false';
      copyBtn.title = 'Copy email to clipboard';
      copyBtn.setAttribute('aria-label', 'Copy email to clipboard');
      copyIcon.innerText = 'content_copy';
      copyLabel.innerText = 'Copy';
    }, 2000);
  };

  if (copyBtn && copyLabel && emailText) {
    copyBtn.addEventListener('click', async () => {
      const email = emailText.innerText.trim();
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(email);
        } else {
          // Non-secure contexts expose no Clipboard API — fall back to a
          // hidden textarea so the button still works on http:// previews.
          const helper = document.createElement('textarea');
          helper.value = email;
          helper.setAttribute('readonly', '');
          helper.style.position = 'fixed';
          helper.style.opacity = '0';
          document.body.appendChild(helper);
          helper.select();
          const ok = (document as any).execCommand('copy');
          document.body.removeChild(helper);
          if (!ok) throw new Error('execCommand copy failed');
        }
        showCopiedState();
      } catch {
        // Naming the failure and the recovery keeps the button honest.
        clearTimeout(copyResetTimer);
        copyLabel.innerText = 'Copy failed';
        copyBtn.title = 'Copy failed — select the email and press Ctrl+C';
        copyResetTimer = setTimeout(() => {
          copyLabel.innerText = 'Copy';
          copyBtn.title = 'Copy email to clipboard';
        }, 3000);
      }
    });
  }
</script>

<style>
  /* Success state must beat the light/dark utility classes on the button. */
  #copyEmailBtn[data-copied='true'] {
    background-color: #047857;
    border-color: #047857;
    color: #ffffff;
  }

  #copyEmailBtn[data-copied='true']:hover {
    background-color: #065f46;
    border-color: #065f46;
  }
</style>
