---
import { getLiveAboutMe } from '../data/aboutMe';
import { GsapReveal } from './interactive/GsapReveal';
import { HyperText } from './interactive/HyperText';

const data = getLiveAboutMe();
---

<section
  class="relative w-full py-16 md:py-24 bg-white/50 dark:bg-[#070b14]/50 border-b border-slate-200/80 dark:border-slate-800/80 overflow-hidden transition-colors"
  id="about"
>
  <!-- Architectural Subtle Grid Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-40 dark:opacity-20 pointer-events-none z-0"></div>

  <!-- Ambient backdrop subtle glow -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-slate-200/30 dark:bg-slate-800/20 blur-3xl pointer-events-none rounded-full"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-slate-200/20 dark:bg-slate-800/15 blur-3xl pointer-events-none rounded-full"></div>

  <div class="relative max-w-[1200px] mx-auto px-6 z-10 section-content-flow">
    
    <!-- Section Header -->
    <GsapReveal y={18} duration={0.6} selector=".reveal-header">
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-6">
        <div>
          <div class="reveal-header inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-slate-100 animate-pulse"></span>
            <span class="font-['Space_Grotesk'] text-[10px] text-slate-700 dark:text-slate-300 uppercase tracking-widest font-bold">
              ABOUT ME // BACKGROUND
            </span>
          </div>
          <h2 class="reveal-header font-['Space_Grotesk'] text-3xl sm:text-4xl md:text-[46px] font-bold text-slate-950 dark:text-white tracking-tight leading-tight">
            {data.title}
          </h2>
          <p class="reveal-header font-['Hanken_Grotesk'] text-lg sm:text-xl text-slate-600 dark:text-slate-400 mt-2 font-normal">
            {data.subtitle}
          </p>
        </div>

        {data.topLabel && (
          <div class="reveal-header mt-4 md:mt-0">
            <span class="font-['Space_Grotesk'] text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">
              {data.topLabel}
            </span>
          </div>
        )}
      </div>
    </GsapReveal>

    <!-- Architectural Horizontal Line Draw (CAD blueprint effect) -->
    <div class="about-divider-h w-full h-[1px] bg-slate-200/90 dark:bg-slate-800 mb-12 origin-left"></div>

    <!-- Main Content: Pure Text Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Core Focus & Tech Highlights -->
      <div class="lg:col-span-4 flex flex-col">
        <GsapReveal y={18} duration={0.6} delay={0.08} selector=".reveal-sidebar">
          {data.stackText && (
            <div class="reveal-sidebar mb-8">
              <span class="font-['Space_Grotesk'] text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-2">
                TECH / STACK HIGHLIGHT
              </span>
              <HyperText
                client:visible
                text={data.stackText}
                as="p"
                className="font-['JetBrains_Mono'] text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200 tracking-wide leading-relaxed cursor-default"
                duration={600}
                delay={150}
                startOnView
                animateOnHover
              />
            </div>
          )}

          <div class="reveal-sidebar relative pl-4">
            <!-- Architectural Vertical Accent Line Draw -->
            <span class="about-accent-v absolute left-0 top-0 bottom-0 w-[2px] bg-slate-300 dark:bg-slate-700 origin-top"></span>
            <p class="font-['Hanken_Grotesk'] text-sm text-slate-500 dark:text-slate-400 leading-relaxed italic">
              "Fokus menciptakan antarmuka yang bersih, responsif, dan fungsional dengan performa yang konsisten."
            </p>
          </div>
        </GsapReveal>
      </div>

      <!-- Right Column: Paragraphs / Biography Narrative -->
      <div class="lg:col-span-8 flex flex-col">
        <GsapReveal y={18} duration={0.6} delay={0.12} selector=".reveal-body" className="space-y-6 flex flex-col">
          {data.paragraphs.map((paragraph, index) => (
            <p
              class={`reveal-body font-['Hanken_Grotesk'] text-slate-700 dark:text-slate-300 leading-relaxed text-justify sm:text-left ${
                index === 0
                  ? 'text-base sm:text-lg font-medium text-slate-800 dark:text-slate-200'
                  : 'text-sm sm:text-base'
              }`}
            >
              {paragraph}
            </p>
          ))}
        </GsapReveal>
      </div>

    </div>

  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../lib/gsap';

  function initAboutLines() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Horizontal blueprint divider drawing across
    const hLine = document.querySelector('.about-divider-h');
    if (hLine) {
      gsap.fromTo(
        hLine,
        { scaleX: 0, transformOrigin: 'left center' },
        {
          scaleX: 1,
          duration: 0.85,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: hLine,
            start: 'top 92%',
            toggleActions: 'play none none none',
          },
        }
      );
    }

    // Vertical accent line drawing downward beside quote
    const vLine = document.querySelector('.about-accent-v');
    if (vLine) {
      gsap.fromTo(
        vLine,
        { scaleY: 0, transformOrigin: 'top center' },
        {
          scaleY: 1,
          duration: 0.7,
          delay: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: vLine,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
        }
      );
    }
  }

  initAboutLines();
</script>
