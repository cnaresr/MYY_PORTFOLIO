---
import { getLiveAboutMe } from '../data/aboutMe';
import { getLiveLanguageSkills, getLiveFrameworkSkills } from '../data/skills';
import { GsapReveal } from './interactive/GsapReveal';
import { HyperText } from './interactive/HyperText';
import { SkillsShowreel } from './interactive/SkillsShowreel';

const data = getLiveAboutMe();
const languages = getLiveLanguageSkills();
const frameworks = getLiveFrameworkSkills();
---

<section
  class="relative w-full py-16 md:py-24 bg-white/50 dark:bg-[#070b14]/50 border-b border-slate-200/80 dark:border-slate-800/80 overflow-hidden transition-colors"
  id="about"
>
  <!-- Architectural Subtle Grid Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-40 dark:opacity-20 pointer-events-none z-0"></div>

  <!-- Ambient backdrop subtle glow -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-slate-200/30 dark:bg-slate-800/20 blur-3xl pointer-events-none rounded-full"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-slate-200/20 dark:bg-slate-800/15 blur-3xl pointer-events-none rounded-full"></div>

  <div class="relative max-w-[1200px] mx-auto px-6 z-10 section-content-flow">
    
    <!-- Section Header (Architectural Style Matching Project Header) -->
    <GsapReveal y={20} duration={0.7} selector=".reveal-about-header">
      <div class="relative mb-12">
        <!-- Giant Architectural Watermark Serial Number -->
        <div class="pointer-events-none absolute -top-8 right-2 sm:right-6 select-none font-mono text-7xl sm:text-8xl lg:text-9xl font-black text-slate-950/[0.03] dark:text-white/[0.03] tracking-tighter">
          01
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 relative z-10">
          <!-- Left Wing: Status Chip + Monumental Typography -->
          <div class="space-y-3">
            <div class="reveal-about-header inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="font-mono text-[10px] uppercase tracking-widest font-bold text-slate-700 dark:text-slate-300">
                {data.badgeLabel || "ABOUT ME // PROFILE DOSSIER"}
              </span>
            </div>

            <div class="reveal-about-header flex items-baseline gap-3 sm:gap-4 flex-wrap">
              <h2 class="font-['Space_Grotesk'] text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-none">
                About Me
              </h2>
              <span class="font-mono text-xs sm:text-sm text-slate-400 dark:text-slate-500 font-semibold tracking-wider uppercase">
                // {data.title || "FULL-STACK ARCHITECTURE"}
              </span>
            </div>
          </div>

          <!-- Right Wing: Precision Telemetry HUD Cards -->
          <div class="reveal-about-header flex items-center gap-3 shrink-0">
            <!-- Focus Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 dark:text-emerald-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">terminal</span>
              </div>
              <div class="flex flex-col">
                <span class="font-['Space_Grotesk'] text-lg font-bold text-slate-950 dark:text-white leading-tight">
                  Full-Stack
                </span>
                <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Engineering Focus
                </span>
              </div>
            </div>

            <!-- Origin Location Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-500 dark:text-sky-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">near_me</span>
              </div>
              <div class="flex flex-col">
                <span class="font-mono text-xs font-bold text-slate-950 dark:text-white leading-tight flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  INDONESIA
                </span>
                <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Semarang UTC+7
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Architectural Blueprint Ruler Divider with Registration Marks -->
        <div class="relative w-full mt-2">
          <div class="w-full h-[1px] bg-slate-200/90 dark:bg-slate-800"></div>
          <span class="absolute -top-1.5 left-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <span class="absolute -top-1.5 right-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <div class="about-divider-h absolute -top-2 left-1/2 -translate-x-1/2 px-3 bg-slate-50 dark:bg-slate-900 text-[9px] font-mono text-slate-400 dark:text-slate-500 uppercase tracking-widest whitespace-nowrap">
            SEC // 01 · ARCHITECTURAL BIOGRAPHY &amp; NARRATIVE
          </div>
        </div>
      </div>
    </GsapReveal>

    <!-- Main Content: Pure Text Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Core Focus & Tech Highlights -->
      <div class="lg:col-span-4 flex flex-col">
        <GsapReveal y={18} duration={0.6} delay={0.08} selector=".reveal-sidebar">
          {data.stackText && (
            <div class="reveal-sidebar mb-8">
              <span class="font-['Space_Grotesk'] text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-2">
                {data.stackLabel || "TECH / STACK HIGHLIGHT"}
              </span>
              <HyperText
                client:visible
                text={data.stackText}
                as="p"
                className="font-['JetBrains_Mono'] text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200 tracking-wide leading-relaxed cursor-default"
                duration={600}
                delay={150}
                startOnView
                animateOnHover
              />
            </div>
          )}

          {data.quote && (
            <div class="reveal-sidebar relative pl-4">
              <!-- Architectural Vertical Accent Line Draw -->
              <span class="about-accent-v absolute left-0 top-0 bottom-0 w-[2px] bg-slate-300 dark:bg-slate-700 origin-top"></span>
              <p class="font-['Hanken_Grotesk'] text-sm text-slate-500 dark:text-slate-400 leading-relaxed italic">
                "{data.quote}"
              </p>
            </div>
          )}
        </GsapReveal>
      </div>

      <!-- Right Column: Paragraphs / Biography Narrative -->
      <div class="lg:col-span-8 flex flex-col">
        <GsapReveal y={18} duration={0.6} delay={0.12} selector=".reveal-body" className="space-y-6 flex flex-col">
          {data.paragraphs.map((paragraph, index) => (
            <p
              class={`reveal-body font-['Hanken_Grotesk'] text-slate-700 dark:text-slate-300 leading-relaxed text-justify sm:text-left ${
                index === 0
                  ? 'text-base sm:text-lg font-medium text-slate-800 dark:text-slate-200'
                  : 'text-sm sm:text-base'
              }`}
            >
              {paragraph}
            </p>
          ))}
        </GsapReveal>
      </div>

    </div>

    <!-- Technical Capabilities & Runtime Showreel -->
    <div id="skills" class="scroll-mt-28 mt-16 pt-10 border-t border-slate-200/80 dark:border-slate-800">
      <SkillsShowreel client:visible languages={languages} frameworks={frameworks} />
    </div>

  </div>
</section>

<script>
  import { gsap } from '../lib/gsap';

  function initAboutLines() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Horizontal blueprint divider drawing across
    const hLine = document.querySelector('.about-divider-h');
    if (hLine) {
      gsap.fromTo(
        hLine,
        { scaleX: 0, transformOrigin: 'left center' },
        {
          scaleX: 1,
          duration: 0.85,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: hLine,
            start: 'top 92%',
            end: 'bottom 15%',
            toggleActions: 'play reverse play reverse',
          },
        }
      );
    }

    // Vertical accent line drawing downward beside quote
    const vLine = document.querySelector('.about-accent-v');
    if (vLine) {
      gsap.fromTo(
        vLine,
        { scaleY: 0, transformOrigin: 'top center' },
        {
          scaleY: 1,
          duration: 0.7,
          delay: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: vLine,
            start: 'top 90%',
            end: 'bottom 15%',
            toggleActions: 'play reverse play reverse',
          },
        }
      );
    }
  }

  initAboutLines();
</script>
