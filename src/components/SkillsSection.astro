---
import { languageSkills, frameworkSkills } from '../data/skills';
import { SkillsMatrix } from './interactive/SkillsMatrix';
// Archived variants (not mounted): 1 SkillsProof.tsx · 2 SkillsRail.tsx ·
// 3 SkillsLayers.tsx · 4 SkillsTagMatrix.tsx. Delete or remount later.

const languages = [...languageSkills];
const frameworks = [...frameworkSkills];
---

<section class="w-full py-16 md:py-20 relative transition-colors overflow-hidden" id="skills">
  <!-- Architectural Subtle Grid Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-40 dark:opacity-20 pointer-events-none z-0"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10 section-content-flow">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-slate-200/80 dark:border-slate-800">
      <div>
        <span class="font-['Space_Grotesk'] text-[11px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold block mb-1">
          CAPABILITY ARCHITECTURE // RUNTIMES &amp; STACKS
        </span>
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl md:text-[44px] font-bold text-slate-950 dark:text-white tracking-tight leading-tight">
          Tech Stack
        </h2>
      </div>
    </div>

    <SkillsMatrix client:visible languages={languages} frameworks={frameworks} />
  </div>
</section>
