---
import { portfolioConfig, formatServicePrice } from '../config';

const services = portfolioConfig.services;
const whatsappUrl = portfolioConfig.links.whatsapp?.trim() || '';
---

{services.length > 0 && (
  <>
    <section
      id="services"
      class="w-full py-16 md:py-24 bg-[#f8f9ff] dark:bg-[#050811] border-t border-slate-200 dark:border-slate-800 relative transition-colors overflow-hidden"
      aria-labelledby="services-heading"
    >
      <!-- Architectural Subtle Grid Pattern -->
      <div
        class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-40 dark:opacity-20 pointer-events-none z-0"
        aria-hidden="true"
      ></div>

      <div class="max-w-[1200px] mx-auto px-6 relative z-10">
        <!-- Architectural Section Header -->
        <div class="relative mb-12">
          <div
            class="pointer-events-none absolute -top-8 right-2 sm:right-6 select-none font-mono text-7xl sm:text-8xl lg:text-9xl font-black text-slate-950/[0.03] dark:text-white/[0.03] tracking-tighter"
            aria-hidden="true"
          >
            04
          </div>

          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 relative z-10">
            <div class="space-y-3">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
                <span class="size-2 rounded-full bg-[var(--site-accent)]" aria-hidden="true"></span>
                <span class="font-mono text-[10px] uppercase tracking-widest font-bold text-slate-700 dark:text-slate-300">
                  FIXED SCOPE &amp; CUSTOM BUILDS
                </span>
              </div>

              <div class="flex items-baseline gap-3 sm:gap-4 flex-wrap">
                <h2
                  id="services-heading"
                  class="font-['Space_Grotesk'] text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-none text-balance"
                >
                  Services
                </h2>
                <span class="font-mono text-xs sm:text-sm text-slate-400 dark:text-slate-500 font-semibold tracking-wider uppercase">
                  // PACKAGES &amp; DELIVERABLES
                </span>
              </div>
            </div>
          </div>

          <!-- Architectural Blueprint Ruler Divider -->
          <div class="relative w-full mt-2">
            <div class="w-full h-[1px] bg-slate-200/90 dark:bg-slate-800"></div>
            <span class="absolute -top-1.5 left-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none" aria-hidden="true">+</span>
            <span class="absolute -top-1.5 right-0 font-mono text-[10px] text-slate-400 dark:text-slate-600 select-none leading-none" aria-hidden="true">+</span>
            <div class="absolute -top-2 left-1/2 -translate-x-1/2 px-3 bg-[#f8f9ff] dark:bg-[#050811] text-[9px] font-mono text-slate-400 dark:text-slate-500 uppercase tracking-widest whitespace-nowrap">
              SEC // 04 · SERVICES &amp; PACKAGES
            </div>
          </div>
        </div>

        <!-- 3 White Service Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {services.map((service) => (
            <article class="flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <h3 class="font-['Space_Grotesk'] text-xl font-bold text-slate-950 dark:text-white tracking-tight text-balance">
                    {service.name}
                  </h3>
                </div>

                <div class="mb-4 pb-4 border-b border-slate-100 dark:border-slate-800">
                  <p class="font-['Space_Grotesk'] text-lg font-extrabold text-slate-950 dark:text-white tabular-nums">
                    {formatServicePrice(service)}
                  </p>
                  <p class="font-['Hanken_Grotesk'] text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed text-pretty">
                    {service.summary}
                  </p>
                </div>

                <ul class="space-y-2.5 mb-6" role="list">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5 font-['Hanken_Grotesk'] text-sm text-slate-700 dark:text-slate-300 leading-snug text-pretty">
                      <span class="mt-1.5 size-1.5 rounded-full bg-[var(--site-accent)] shrink-0" aria-hidden="true"></span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {whatsappUrl ? (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-slate-950 font-['Space_Grotesk'] text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--site-accent)] focus-visible:ring-offset-2"
                >
                  <span>{service.ctaLabel}</span>
                  <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_outward</span>
                </a>
              ) : (
                <button
                  type="button"
                  data-service-cta={service.name}
                  class="service-discuss-btn inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-slate-950 font-['Space_Grotesk'] text-sm font-bold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--site-accent)] focus-visible:ring-offset-2"
                >
                  <span>{service.ctaLabel}</span>
                  <span class="material-symbols-outlined text-[16px]" aria-hidden="true">chat</span>
                </button>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.service-discuss-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const service = btn.dataset.serviceCta || undefined;
          window.dispatchEvent(new CustomEvent('open-hire-modal', { detail: { service } }));
        });
      });
    </script>
  </>
)}
