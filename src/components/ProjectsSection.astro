---
import { projects } from '../data/projects';
import { BentoProjectGrid } from './interactive/BentoProjectGrid';
import { GsapReveal } from './interactive/GsapReveal';

const totalProjects = projects.length;
const totalProjectsFormatted = totalProjects < 10 ? `0${totalProjects}` : `${totalProjects}`;
---

<section
  class="relative w-full py-16 md:py-24 bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800 transition-colors overflow-hidden"
  id="projects"
>
  <!-- Architectural Subtle Grid Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] dark:bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-35 dark:opacity-20 pointer-events-none z-0"></div>

  <!-- Ambient backdrop radials -->
  <div class="absolute -top-24 right-0 w-[520px] h-[360px] bg-gradient-to-bl from-slate-300/30 dark:from-slate-700/20 via-transparent to-transparent blur-3xl pointer-events-none rounded-full" />
  <div class="absolute bottom-10 -left-16 w-[420px] h-[320px] bg-gradient-to-tr from-slate-200/30 dark:from-slate-800/25 via-transparent to-transparent blur-3xl pointer-events-none rounded-full" />

  <div class="relative max-w-[1200px] mx-auto px-6 z-10 section-content-flow">
    <!-- Redesigned Architectural Header -->
    <GsapReveal y={20} duration={0.7} selector=".reveal-proj-header">
      <div class="relative mb-12">
        <!-- Giant Architectural Watermark Serial Number -->
        <div class="pointer-events-none absolute -top-8 right-2 sm:right-6 select-none font-mono text-7xl sm:text-8xl lg:text-9xl font-black text-slate-950/[0.03] dark:text-white/[0.03] tracking-tighter">
          02
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 relative z-10">
          <!-- Left Wing: Status Chip + Monumental Typography -->
          <div class="space-y-3">
            <div class="reveal-proj-header inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="font-mono text-xs uppercase tracking-widest font-bold text-slate-700 dark:text-slate-300">
                CURATED WORK // PRODUCTION PLATFORMS
              </span>
            </div>

            <div class="reveal-proj-header flex items-baseline gap-3 sm:gap-4 flex-wrap">
              <h2 class="font-['Space_Grotesk'] text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-none">
                Project
              </h2>
              <span class="font-mono text-xs sm:text-sm text-slate-400 dark:text-slate-500 font-semibold tracking-wider uppercase">
                // ARCHITECTURAL INDEX
              </span>
            </div>
          </div>

          <!-- Right Wing: Precision Telemetry HUD Cards -->
          <div class="reveal-proj-header flex items-center gap-3 shrink-0">
            <!-- Count Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 dark:text-emerald-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">terminal</span>
              </div>
              <div class="flex flex-col">
                <span class="font-['Space_Grotesk'] text-lg font-bold text-slate-950 dark:text-white leading-tight">
                  {totalProjectsFormatted}
                </span>
                <span class="font-mono text-[11px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Platforms Shipped
                </span>
              </div>
            </div>

            <!-- Live Status Pill -->
            <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-2xs flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-500 dark:text-sky-400 shrink-0">
                <span class="material-symbols-outlined text-[18px]">deployed_code</span>
              </div>
              <div class="flex flex-col">
                <span class="font-mono text-xs font-bold text-slate-950 dark:text-white leading-tight flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  LIVE
                </span>
                <span class="font-mono text-[11px] text-slate-400 dark:text-slate-500 uppercase tracking-wider font-semibold">
                  Verified Repos
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Architectural Blueprint Ruler Divider with Registration Marks -->
        <div class="relative w-full mt-2">
          <div class="w-full h-[1px] bg-slate-200/90 dark:bg-slate-800"></div>
          <span class="absolute -top-1.5 left-0 font-mono text-xs text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <span class="absolute -top-1.5 right-0 font-mono text-xs text-slate-400 dark:text-slate-600 select-none leading-none">+</span>
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 px-3 bg-slate-50 dark:bg-slate-900 text-[11px] font-mono text-slate-400 dark:text-slate-500 uppercase tracking-widest whitespace-nowrap">
            SEC // 02 · CASE STUDIES REPOSITORY
          </div>
        </div>
      </div>
    </GsapReveal>

    <!-- Bento Grid with laptop-open scroll animation -->
    <BentoProjectGrid client:visible projects={[...projects]} />
  </div>
</section>
