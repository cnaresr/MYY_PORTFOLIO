---
import { siteConfig } from '../data/siteConfig';
import { FloatingIconsHero } from './interactive/FloatingIconsHero';
---

<!-- Kept on client:load. The hero is the LCP element and holds the primary CTA
     plus the CV dialog, so its interactivity must not wait for a viewport
     callback. -->
<FloatingIconsHero
  client:load
  title={siteConfig.title}
  subtitle={siteConfig.subtitle}
  summary={siteConfig.summary}
  avatar={siteConfig.avatar}
  name={siteConfig.name}
  initials={siteConfig.initials}
  ctaText="Explore Works"
  ctaHref="#projects"
  cvPdf={siteConfig.cvPdf}
/>
