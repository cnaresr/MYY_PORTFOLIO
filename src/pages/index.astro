---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutMeSection from '../components/AboutMeSection.astro';
import SkillsTicker from '../components/SkillsTicker.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import CertificatesSection from '../components/CertificatesSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { SpecModal } from '../components/interactive/SpecModal';
import { getLiveProjects } from '../data/projects';

const liveProjects = getLiveProjects();
---

<Layout>
  <Header />
  <main class="w-full pt-24 overflow-x-hidden">
    <Hero />
    <SkillsTicker />
    <AboutMeSection />
    <SkillsSection />
    <ProjectsSection />
    <CertificatesSection />
    <ContactSection />
  </main>
  <Footer />
  <SpecModal client:load projects={liveProjects} />
</Layout>

<script>
  import { initSectionFlowTransitions } from '../lib/sectionFlowTransitions';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initSectionFlowTransitions();
    });
  } else {
    initSectionFlowTransitions();
  }

  document.addEventListener('astro:page-load', () => {
    initSectionFlowTransitions();
  });
</script>
