---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ProfileManager } from '../../../components/admin/ProfileManager';
import { getProfileData } from '../../../lib/contentStore';

// Fall back to sensible defaults when profile.json is missing or wiped,
// so the admin form never renders completely empty.
const DEFAULT_PROFILE = {
  name: 'Cezar nareswara respati',
  initials: 'CNR',
  role: 'Full-Stack Architect',
  title: 'CEZAR NARESWARA RESPATI',
  subtitle: 'Code with Passion, Build with Purpose',
  summary:
    'Full-Stack Developer & Software Architect based in Indonesia, specializing in high-performance web applications, scalable backend systems, and modern digital platforms.',
  email: 'cezar.nares@gmail.com',
  country: 'Indonesia',
  officeAddress: '',
  homeAddress: 'Semarang, Tembalang, Central Java',
  avatar: '/images/avatar-hero.jpg',
  cvPdf: '/Cezar_Nareswara_Resume.pdf',
  socialLinks: [
    { name: 'GitHub', href: 'https://github.com/cnaresr', icon: 'code' },
    { name: 'LinkedIn', href: 'https://www.linkedin.com/in/cezar-nareswara-respati-8b8a55327/', icon: 'arrow_outward' },
    { name: 'Instagram', href: 'https://www.instagram.com/czr_nr/', icon: 'arrow_outward' },
  ],
};

let profile: any;
try {
  const raw = getProfileData();
  profile = raw && Object.keys(raw).length > 0 ? { ...DEFAULT_PROFILE, ...raw } : DEFAULT_PROFILE;
} catch {
  profile = DEFAULT_PROFILE;
}
---

<AdminLayout title="Profile & Hero // Root Spec" activeNav="profile" breadcrumbs="PLATFORM / PROFILE">
  <ProfileManager client:load initialProfile={profile} />
</AdminLayout>
