---
import '../styles/global.css';
import { siteConfig } from '../data/siteConfig';
import { SmoothCursor } from '../components/ui/smooth-cursor';
import OfflineOverlay from '../components/interactive/OfflineOverlay';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.subtitle}`,
  description = siteConfig.summary,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1128" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteConfig.avatar} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={siteConfig.avatar} />

    <!-- Google Fonts Preconnect & Stylesheets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- Inline theme bootstrap: applies persisted theme before paint to avoid FOUC.
         Mirrors next-themes' own init script but works without a React root. -->
    <script is:inline>
      (function () {
        try {
          var storedTheme = localStorage.getItem('theme') || 'system';
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var resolved = storedTheme === 'system' ? (systemDark ? 'dark' : 'light') : storedTheme;
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(resolved);
          root.style.colorScheme = resolved;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#f8f9ff] dark:bg-[#050811] text-slate-900 dark:text-slate-100 selection:bg-slate-900 selection:text-white dark:selection:bg-white dark:selection:text-slate-900 min-h-screen flex flex-col antialiased">
    <SmoothCursor client:load />
    <OfflineOverlay client:load />
    <slot />
  </body>
</html>
