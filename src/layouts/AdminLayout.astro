---
import '../styles/global.css';
import { siteConfig } from '../data/siteConfig';
import { TreeNav } from '../components/ui/tree-nav';
import { AdminThemeToggle } from '../components/admin/AdminThemeToggle';
import OfflineOverlay from '../components/interactive/OfflineOverlay';

interface Props {
  title?: string;
  activeNav?: string;
  breadcrumbs?: string;
}

const {
  title = 'ARCH.CMS // Workspace',
  activeNav = 'overview',
  breadcrumbs = 'OVERVIEW',
} = Astro.props;

const operatorName = siteConfig?.name || 'Admin';
const operatorInitials = (siteConfig?.initials || operatorName.slice(0, 2)).toUpperCase();

interface NavItem {
  id: string;
  name: string;
  href: string;
  icon: string;
  badge?: string;
}

interface NavGroup {
  section: string;
  items: NavItem[];
}

const navItems: NavGroup[] = [
  {
    section: 'Platform Core',
    items: [
      { id: 'overview', name: 'Overview & Analytics', href: '/user/admin/overview', icon: 'grid_view' },
      { id: 'profile', name: 'Profile & Hero', href: '/user/admin/profile', icon: 'badge' },
      { id: 'about', name: 'About Me', href: '/user/admin/about', icon: 'person' },
    ],
  },
  {
    section: 'Editorial & Assets',
    items: [
      { id: 'projects', name: 'Projects Showcase', href: '/user/admin/projects', icon: 'terminal' },
      { id: 'skills', name: 'Skills & Tech Stack', href: '/user/admin/skills', icon: 'tune' },
    ],
  },
];

// Flatten navItems into TreeNav groups (label + per-item meta).
const treeGroups = navItems.map((group) => ({
  section: group.section,
  items: group.items.map((item) => ({
    id: item.id,
    label: item.name,
    href: item.href,
    icon: item.icon,
    badge: item.badge,
  })),
}));
---

<!doctype html>
<html lang="en" class="admin-cockpit">
  <head>
    <meta charset="UTF-8" />
    <!-- Theme bootstrap: mirrors the public site (localStorage "theme"),
         defaults to the dark cockpit. Runs before paint (anti-FOUC). -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var resolved =
            stored === 'light' ? 'light'
            : stored === 'dark' ? 'dark'
            : stored === 'system' ? (sysDark ? 'dark' : 'light')
            : 'dark';
          var root = document.documentElement;
          root.classList.add(resolved === 'dark' ? 'dark' : 'admin-light');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ARCH.CMS</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-cockpit text-cockpit-text font-['Hanken_Grotesk'] antialiased min-h-screen flex flex-col"
    data-sidebar-state="expanded"
  >
    <!-- Inline sidebar bootstrap: restore collapsed state from cookie before paint (anti-FOUC). -->
    <script is:inline>
      (function () {
        try {
          var m = document.cookie.match(/(?:^|;\s*)sidebar_state=(expanded|collapsed)/);
          if (m && m[1] === 'collapsed') document.body.dataset.sidebarState = 'collapsed';
        } catch (e) {}
      })();
    </script>
    <OfflineOverlay client:load />
    <!-- Fixed Sidebar Desktop (collapsible, shadcn-style offcanvas animation) -->
    <aside
      id="adminSidebar"
      class="admin-sidebar bg-cockpit-panel border-r border-cockpit-line fixed top-0 left-0 bottom-0 z-40 hidden lg:flex flex-col justify-between select-none transition-[width] duration-200 ease-linear overflow-hidden w-64"
    >
      <div class="admin-sidebar-inner w-64 flex flex-col flex-1 min-h-0">
        <!-- Brand Header -->
        <div class="h-16 px-5 border-b border-cockpit-line flex items-center justify-between gap-2.5">
          <a href="/user/admin/overview" class="flex items-center gap-2.5 group min-w-0 flex-1">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 shadow-xs shadow-emerald-500/10 group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[17px]">terminal</span>
            </div>
            <div class="flex flex-col min-w-0 transition-opacity duration-150" data-sidebar-label>
              <div class="flex items-center gap-1.5">
                <span class="font-['Space_Grotesk'] text-sm font-bold tracking-tight text-cockpit-text leading-none truncate">
                  ARCH.CMS
                </span>
                <span class="px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[9px] font-bold border border-emerald-500/30">
                  v2.6
                </span>
              </div>
              <span class="font-mono text-[9px] text-cockpit-faint mt-0.5 uppercase tracking-wider">
                Production Console
              </span>
            </div>
          </a>
          <!-- Hamburger: toggles sidebar collapse (desktop) / opens drawer (mobile) -->
          <button
            id="adminMobileToggle"
            type="button"
            class="p-1.5 rounded-lg border border-cockpit-line text-cockpit-muted hover:bg-cockpit-hover hover:text-cockpit-text cursor-pointer shrink-0 transition-colors"
            aria-label="Toggle Admin Menu"
            aria-expanded="true"
            aria-controls="adminSidebar"
          >
            <span class="material-symbols-outlined text-[20px]">menu</span>
          </button>
        </div>

        <!-- Navigation Sections (TreeNav island) -->
        <TreeNav client:load groups={treeGroups} activeId={activeNav} />
      </div>

      <!-- Sidebar Footer: System Status & Live Portfolio link -->
      <div class="p-3.5 border-t border-cockpit-line space-y-2.5 transition-opacity duration-150" data-sidebar-label>
        <div class="p-2.5 rounded-lg bg-cockpit-raised/80 border border-cockpit-line text-[11px] font-mono space-y-1">
          <div class="flex items-center justify-between text-cockpit-faint">
            <span>ENGINE</span>
            <span class="text-cockpit-text font-bold">Astro 5 + Vite</span>
          </div>
          <div class="flex items-center justify-between text-cockpit-faint">
            <span>STORAGE</span>
            <span class="text-emerald-400 font-bold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              SYNCED
            </span>
          </div>
        </div>

        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 hover:text-emerald-200 font-mono text-xs font-semibold transition-all shadow-2xs group"
        >
          <span>View Live Site</span>
          <span class="material-symbols-outlined text-[14px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">open_in_new</span>
        </a>
      </div>
    </aside>

    <!-- Top Header (shifts with sidebar state) -->
    <header class="admin-header h-16 bg-cockpit-panel/90 backdrop-blur-md border-b border-cockpit-line fixed top-0 right-0 z-30 flex items-center justify-between px-4 sm:px-8 transition-[left] duration-200 ease-linear left-64">
      <!-- Expand trigger (visible only when sidebar collapsed) + Breadcrumbs (desktop) -->
      <div class="flex items-center gap-3 min-w-0">
        <button
          id="adminSidebarExpand"
          type="button"
          class="lg:flex p-1.5 rounded-lg border border-cockpit-line text-cockpit-muted hover:bg-cockpit-hover hover:text-cockpit-text cursor-pointer shrink-0 transition-opacity duration-150 opacity-0 pointer-events-none lg:opacity-0 lg:pointer-events-none"
          aria-label="Expand Admin Menu"
          aria-controls="adminSidebar"
        >
          <span class="material-symbols-outlined text-[20px]">menu</span>
        </button>

        <div class="hidden lg:flex items-center gap-2 font-mono text-xs min-w-0">
          <span class="text-cockpit-faint">CONSOLE</span>
          <span class="text-cockpit-line-strong">/</span>
          <span class="text-cockpit-faint">WORKSPACE</span>
          <span class="text-cockpit-line-strong">/</span>
          <span class="text-emerald-400 font-bold tracking-wider uppercase">{breadcrumbs}</span>
        </div>
      </div>

      <!-- Right Utility Bar -->
      <div class="flex items-center gap-3">
        <!-- Live System Telemetry Ping -->
        <div class="hidden xl:flex items-center gap-2 px-3 py-1 rounded-md bg-cockpit-raised/90 border border-cockpit-line font-mono text-[11px] text-cockpit-text shadow-2xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-semibold tracking-wide">SYSTEMS OPERATIONAL</span>
          <span class="text-cockpit-faint">// 12ms</span>
        </div>

        <!-- Quick View Site button -->
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-cockpit-raised hover:bg-cockpit-hover border border-cockpit-line text-cockpit-muted hover:text-cockpit-text font-mono text-xs transition-colors"
          title="Open live portfolio in new tab"
        >
          <span>Live Site</span>
          <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
        </a>

        <!-- Operator identity -->
        <div class="hidden sm:flex items-center gap-2.5 pl-1" title={`Signed in as ${operatorName}`}>
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500/20 to-sky-500/20 border border-emerald-500/40 flex items-center justify-center font-['Space_Grotesk'] text-xs font-bold text-emerald-300 shrink-0 overflow-hidden shadow-2xs">
            {operatorInitials}
          </div>
          <div class="hidden md:flex flex-col leading-tight min-w-0">
            <span class="font-['Space_Grotesk'] text-xs font-bold text-cockpit-text truncate max-w-[150px]">{operatorName}</span>
            <span class="font-mono text-[9px] text-emerald-400 flex items-center gap-1">
              <span class="w-1 h-1 rounded-full bg-emerald-400"></span>
              Lead Architect
            </span>
          </div>
        </div>

        <span class="hidden lg:block w-px h-6 bg-cockpit-line"></span>

        <!-- Theme toggle (animated reveal, same as public dashboard) -->
        <AdminThemeToggle client:only="react" />

        <span class="hidden lg:block w-px h-6 bg-cockpit-line"></span>

        <!-- Logout button -->
        <a
          href="/api/auth/logout"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-cockpit-line hover:border-rose-500/40 hover:bg-rose-500/10 text-cockpit-muted hover:text-rose-400 font-mono text-xs font-semibold transition-all"
          title="Sign out of ARCH.CMS"
        >
          <span class="material-symbols-outlined text-[16px]">logout</span>
          <span class="hidden sm:inline">Logout</span>
        </a>
      </div>
    </header>

    <!-- Mobile Drawer Overlay (slide-in sheet, shadcn-style) -->
    <div id="adminMobileDrawer" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs invisible opacity-0 transition-[opacity,visibility] duration-200 lg:hidden" aria-hidden="true">
      <div
        id="adminMobileDrawerPanel"
        class="w-64 bg-cockpit-panel border-r border-cockpit-line h-full flex flex-col justify-between p-4 shadow-2xl -translate-x-full transition-transform duration-200 ease-out"
      >
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-cockpit-line mb-4">
            <span class="font-['Space_Grotesk'] text-base font-bold text-cockpit-text">ARCH.CMS</span>
            <button id="closeMobileDrawer" class="p-1 text-cockpit-muted hover:text-cockpit-text cursor-pointer">
              <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
          </div>
          <nav class="space-y-4">
            {navItems.map((group) => (
              <div>
                <div class="font-['Space_Grotesk'] text-[10px] font-bold text-cockpit-muted uppercase tracking-widest px-2 mb-1">
                  {group.section}
                </div>
                <ul class="space-y-1">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class={`flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium ${
                          activeNav === item.id
                            ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-semibold'
                            : 'text-cockpit-muted hover:text-cockpit-text hover:bg-cockpit-hover'
                        }`}
                      >
                        <div class="flex items-center gap-2">
                          <span class="material-symbols-outlined text-[18px]">{item.icon}</span>
                          <span>{item.name}</span>
                        </div>
                        {item.badge && (
                          <span class="px-1.5 py-0.5 rounded font-mono text-[10px] bg-emerald-500/15 text-emerald-300 font-bold">
                            {item.badge}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>
        <div class="pt-4 border-t border-cockpit-line">
          <a
            href="/api/auth/logout"
            class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 font-mono text-xs font-bold"
          >
            <span>Sign Out</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Container (shifts with sidebar state) -->
    <main class="admin-main pt-16 flex-1 min-h-screen transition-[margin] duration-200 ease-linear lg:ml-64">
      <div class="max-w-[1440px] mx-auto p-4 sm:p-6 lg:p-8">
        <slot />
      </div>
    </main>

    <script>
      // ---- shadcn-style sidebar state machine (vanilla port) ----
      // body[data-sidebar-state=expanded|collapsed] drives widths via
      // arbitrary variants; state persists in the sidebar_state cookie.
      const SIDEBAR_COOKIE = 'sidebar_state';
      const COOKIE_MAX_AGE = 60 * 60 * 24 * 7;

      const body = document.body;
      const drawer = document.getElementById('adminMobileDrawer');
      const drawerPanel = document.getElementById('adminMobileDrawerPanel');
      const closeBtn = document.getElementById('closeMobileDrawer');

      const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;

      const setState = (state: string) => {
        body.dataset.sidebarState = state;
        document.cookie = `${SIDEBAR_COOKIE}=${state}; path=/; max-age=${COOKIE_MAX_AGE}`;
        document.querySelectorAll('#adminMobileToggle').forEach((btn) => {
          btn.setAttribute('aria-expanded', String(state === 'expanded'));
        });
      };

      const openDrawer = () => {
        if (!drawer || !drawerPanel) return;
        drawer.classList.remove('invisible', 'opacity-0');
        drawer.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(() => drawerPanel.classList.remove('-translate-x-full'));
      };

      const closeDrawer = () => {
        if (!drawer || !drawerPanel) return;
        drawerPanel.classList.add('-translate-x-full');
        drawer.classList.add('invisible', 'opacity-0');
        drawer.setAttribute('aria-hidden', 'true');
      };

      document.querySelectorAll('#adminMobileToggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (isMobile()) {
            openDrawer();
          } else {
            setState(body.dataset.sidebarState === 'expanded' ? 'collapsed' : 'expanded');
          }
        });
      });

      // Expand trigger in the header (shown when sidebar collapsed).
      document.getElementById('adminSidebarExpand')?.addEventListener('click', () => {
        setState('expanded');
      });

      closeBtn?.addEventListener('click', closeDrawer);
      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer && !drawer.classList.contains('invisible')) closeDrawer();
      });

      // Keyboard shortcut: Ctrl/Cmd + B toggles the sidebar (desktop only).
      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() === 'b' && (e.metaKey || e.ctrlKey) && !isMobile()) {
          e.preventDefault();
          setState(body.dataset.sidebarState === 'expanded' ? 'collapsed' : 'expanded');
        }
      });
    </script>
  </body>
</html>
