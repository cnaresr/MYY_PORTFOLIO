---
import { projects } from '../data/projects';
import { formatRange } from '../lib/formatDate';
---

<section class="w-full py-16 md:py-24 bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800 transition-colors" id="projects">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-slate-200/80 dark:border-slate-800">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs mb-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-slate-100 animate-pulse"></span>
          <span class="font-['Space_Grotesk'] text-[10px] text-slate-700 dark:text-slate-300 uppercase tracking-widest font-bold">
            SELECTED CASE STUDIES // ARCHITECTURE &amp; PRODUCTION
          </span>
        </div>
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl md:text-[46px] font-bold text-slate-950 dark:text-white tracking-tight leading-tight">
          Featured Systems Architecture
        </h2>
      </div>
      <p class="font-['Hanken_Grotesk'] text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-md mt-3 md:mt-0 leading-relaxed">
        Production-grade distributed platforms, low-latency telemetry fabrics, and compiler engines engineered with strict SLA guarantees.
      </p>
    </div>

    <!-- Project List -->
    <div class="space-y-10">
      {projects.map((project, index) => (
        <article class="group rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-xl hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-8 items-center">
            <!-- Left Info Column -->
            <div class="lg:col-span-7 flex flex-col items-start">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-950 font-['Space_Grotesk'] text-[10px] uppercase tracking-wider font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-slate-950 animate-pulse"></span>
                  {project.status}
                </span>
                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-mono text-[11px] text-slate-700 dark:text-slate-300 font-semibold">
                  SYS {String(index + 1).padStart(2, '0')}
                </span>
                <span class="font-mono text-[12px] text-slate-500 dark:text-slate-400 font-medium">
                  {formatRange(project.startDate, project.endDate)}
                </span>
              </div>

              <h3 class="font-['Space_Grotesk'] text-2xl sm:text-[26px] text-slate-950 dark:text-white tracking-tight mb-2.5 font-bold group-hover:text-black dark:group-hover:text-slate-200 transition-colors">
                {project.title}
              </h3>

              <p class="font-['Hanken_Grotesk'] text-sm sm:text-[15px] text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                {project.description}
              </p>

              <!-- Tech tags & Links -->
              <div class="flex flex-wrap items-center gap-2 w-full pt-1">
                {project.technologies.map((tech) => (
                  <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-mono text-[11px] text-slate-800 dark:text-slate-200 font-medium">
                    {tech}
                  </span>
                ))}

                <div class="grow hidden sm:block"></div>

                <div class="flex items-center gap-2 w-full sm:w-auto mt-3 sm:mt-0">
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-mono text-xs font-semibold transition-colors"
                  >
                    <span class="material-symbols-outlined text-[16px]">code</span>
                    <span>GitHub Repo</span>
                  </a>

                  <button
                    type="button"
                    class="inspect-spec-btn inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-950 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-200 text-white dark:text-slate-950 font-mono text-xs font-semibold shadow-xs transition-colors cursor-pointer"
                    data-project-id={project.id}
                  >
                    <span>View Spec</span>
                    <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Right Preview -->
            <div class="lg:col-span-5 rounded-lg border border-slate-300/80 dark:border-slate-700 bg-slate-950 overflow-hidden shadow-md flex flex-col relative group/preview">
              <div class="h-60 sm:h-68 lg:h-72 relative overflow-hidden bg-slate-950">
                <img
                  src={project.image}
                  alt={`Interface preview of ${project.title}`}
                  class="w-full h-full object-cover opacity-90 contrast-125 transition-transform duration-500 group-hover/preview:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-transparent to-transparent pointer-events-none"></div>

                <!-- Overlay Telemetry Tag -->
                <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2 py-1 rounded bg-slate-900/90 border border-slate-700/80 font-mono text-[10px] text-slate-300 backdrop-blur-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>LIVE REPLICA // ACTIVE SHARDS</span>
                </div>

                <!-- Hover Scanline Glow -->
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-emerald-500/10 to-transparent opacity-0 group-hover/preview:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest ? e.target.closest('.inspect-spec-btn') : null;
    if (!btn) return;
    
    e.preventDefault();
    var projectId = btn.getAttribute('data-project-id');
    if (typeof window.openSpecModal === 'function') {
      window.openSpecModal(projectId);
    } else {
      window.dispatchEvent(
        new CustomEvent('open-spec-modal', {
          detail: { projectId: projectId },
        })
      );
    }
  });
</script>