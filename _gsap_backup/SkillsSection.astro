---
import { languageSkills, frameworkSkills } from '../data/skills';
import { Star, Crown } from 'lucide-react';

// Convert a 0-100 skill percentage into per-star fill (0..1).
function getStars(percentage: number): number[] {
  const value = Math.min(5, Math.max(0, percentage / 20));
  return Array.from({ length: 5 }, (_, i) => Math.min(1, Math.max(0, value - i)));
}
---

<section class="w-full py-16 md:py-20 relative transition-colors" id="skills">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-slate-200/80 dark:border-slate-800">
      <div>
        <span class="font-['Space_Grotesk'] text-[11px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-bold block mb-1">
          CAPABILITY ARCHITECTURE // RUNTIMES &amp; STACKS
        </span>
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl md:text-[44px] font-bold text-slate-950 dark:text-white tracking-tight leading-tight">
          Skills
        </h2>
      </div>
      <div class="mt-4 md:mt-0">
        <a
          href="#projects"
          class="inline-flex items-center gap-1.5 font-mono text-xs text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white font-semibold transition-colors group"
        >
          <span>View Detailed Skills Matrix</span>
          <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">
            arrow_forward
          </span>
        </a>
      </div>
    </div>

    <!-- Skills 2-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Card 1: Language Expertise -->
      <div class="p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-all">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-5">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-slate-800 dark:text-slate-200 text-[18px]">code</span>
            <h3 class="font-['Space_Grotesk'] text-[17px] text-slate-950 dark:text-white font-bold">Language Expertise</h3>
          </div>
          <span class="font-['Space_Grotesk'] text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">
            CORE SYNTAX
          </span>
        </div>

        <div class="space-y-4">
          {languageSkills.map((skill) => (
            <div class="flex flex-wrap items-center justify-between gap-2 py-2 border-b border-slate-100 dark:border-slate-800 last:border-b-0">
              <div class="flex items-center gap-2">
                <span class="font-['Space_Grotesk'] text-[14px] text-slate-900 dark:text-slate-100 font-semibold">
                  {skill.name}
                </span>
                <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">
                  {skill.detail}
                </span>
              </div>
              <div class="flex items-center gap-1.5">
                {skill.master && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gradient-to-r from-amber-50 to-amber-100 dark:from-amber-900/30 dark:to-amber-800/30 border border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400 font-mono text-[10px] font-bold uppercase tracking-wide shadow-2xs">
                    <Crown className="w-3 h-3" /> Master
                  </span>
                )}
                <div class="flex items-center gap-0.5 text-amber-400">
                  {getStars(skill.percentage).map((fill, idx) => (
                    <span class="relative inline-block w-3.5 h-3.5" data-index={idx}>
                      <Star className="absolute inset-0 w-3.5 h-3.5 text-slate-200 dark:text-slate-700" />
                      <span class="absolute inset-0 overflow-hidden" style={`width: ${Math.round(fill * 100)}%`}>
                        <Star className="w-3.5 h-3.5 fill-current" />
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Card 2: Framework & Engine Expertise -->
      <div class="p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-all">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-5">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-slate-800 dark:text-slate-200 text-[18px]">layers</span>
            <h3 class="font-['Space_Grotesk'] text-[17px] text-slate-950 dark:text-white font-bold">Framework &amp; Engine Expertise</h3>
          </div>
          <span class="font-['Space_Grotesk'] text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">
            PLATFORMS &amp; RUNTIMES
          </span>
        </div>

        <div class="space-y-4">
          {frameworkSkills.map((skill) => (
            <div class="flex flex-wrap items-center justify-between gap-2 py-2 border-b border-slate-100 dark:border-slate-800 last:border-b-0">
              <div class="flex items-center gap-2">
                <span class="font-['Space_Grotesk'] text-[14px] text-slate-900 dark:text-slate-100 font-semibold">
                  {skill.name}
                </span>
                <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">
                  {skill.detail}
                </span>
              </div>
              <div class="flex items-center gap-1.5">
                {skill.master && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gradient-to-r from-amber-50 to-amber-100 dark:from-amber-900/30 dark:to-amber-800/30 border border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400 font-mono text-[10px] font-bold uppercase tracking-wide shadow-2xs">
                    <Crown className="w-3 h-3" /> Master
                  </span>
                )}
                <div class="flex items-center gap-0.5 text-amber-400">
                  {getStars(skill.percentage).map((fill, idx) => (
                    <span class="relative inline-block w-3.5 h-3.5" data-index={idx}>
                      <Star className="absolute inset-0 w-3.5 h-3.5 text-slate-200 dark:text-slate-700" />
                      <span class="absolute inset-0 overflow-hidden" style={`width: ${Math.round(fill * 100)}%`}>
                        <Star className="w-3.5 h-3.5 fill-current" />
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
